AI_CS_APP_ENV=development
AI_CS_APP_NAME=AI Customer Service API
AI_CS_DEBUG=true
AI_CS_DATABASE_URL=sqlite+aiosqlite:///./backend-dev.db
AI_CS_JOURNAL_DATABASE_URL=sqlite+aiosqlite:///./journal-dev.db
AI_CS_SECRET_KEY=replace-with-a-long-random-string
AI_CS_ALLOWED_ORIGINS=["http://127.0.0.1:4173","http://127.0.0.1:5173"]
AI_CS_API_ORIGIN=http://127.0.0.1:8000
AI_CS_SESSION_COOKIE_NAME=cs_session
AI_CS_SESSION_IDLE_TTL_MINUTES=480
AI_CS_SESSION_ABSOLUTE_TTL_HOURS=12
AI_CS_SESSION_REMEMBER_ABSOLUTE_TTL_HOURS=168
AI_CS_CSRF_TTL_SECONDS=1800
AI_CS_COOKIE_SECURE=false
AI_CS_COOKIE_SAMESITE=lax
AI_CS_COOKIE_DOMAIN=
AI_CS_WORKSPACE_TZ=Asia/Shanghai
AI_CS_AUTO_CREATE_SCHEMA=false
AI_CS_BOOTSTRAP_ENABLED=false
AI_CS_BOOTSTRAP_ADMIN_USERNAME=admin
AI_CS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-password
AI_CS_INSTANCE_ID=local-api-1
AI_CS_PROVIDER_ALLOWED_HOSTS=["api.example.com"]
AI_CS_PROVIDER_KEY_ENCRYPTION_KEY=replace-with-a-separate-32-byte-base64-key
# Development-only local test provider exception. Do not enable in production.
AI_CS_PROVIDER_ALLOW_HTTP_FOR_LOCAL_TESTING=false
